@page
@using System.Globalization
@using AFRA.Members.Backend
@using AFRA.Members.Backend.database
@using LinqToDB
@model IndexModel
@{
	ViewData["Title"] = "Members";
	Layout = "_LayoutNoContainer";

	var db = new Database.DbConn();
}

@section Stylesheets {
	<link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css"/>
}

@section Scripts {
	<script src="~/lib/datatables/jquery.dataTables.min.js"></script>
	<script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
	<script>
	$(document).ready( function () {
		let search = "";
		
		if (window.location.hash.startsWith("#member_")) {
			search = decodeURI(window.location.hash.substring(8));
		}
    using LinqToDB;
		
		$('#members').DataTable({
        	lengthMenu: [10, 25, 50, 100, -1],
    using AFRA.Members.Backend.database.Tables;
        	pageLength: 25,
        	search: {
				search: search,
			}
        });
    } );
	</script>
}

<div class="text-center">
	<h1 class="display-5">
		Members
		<a class="btn btn-lg btn-primary" href="/AddMember">Add</a>

	</h1>
</div>
<div>
	<table class="table table-striped table-hover" id="members">
		<thead>
		<tr>
			<th scope="col">Name</th>
			<th scope="col">Address</th>
			<th scope="col">Email</th>
			<th scope="col">Phone</th>
			<th scope="col">DoB</th>
			<th scope="col">Membership</th>
			<th scope="col">Fee</th>
			<th scope="col">Notes</th>
			<th scope="col">Actions</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var member in db.Members.LoadWith(x => x.Memberships).OrderBy(p => p.FirstName!.ToLower())) {
			<tr id="member_@member.MemberId" data-member-id="@member.MemberId">
				<td>
					<b>@member.FirstName</b> @member.LastName
					<br/>
					<small>@member.Nick</small>
				</td>
				<td>
					@member.Street
					<small>@member.FirstAddressLine</small>
					<br/>
					<small>@member.Zip <b>@member.City</b>, @member.Country</small>
				</td>
				<td>
					@member.Email
				</td>
				<td>
					@member.Phone
				</td>
				<td>
					@member.DateOfBirth?.ToString("yyyy-MM-dd")
				</td>
				<td>
					@* @member.MembershipStart?.ToString("yyyy-MM-dd")
					@if (member.MembershipEnd?.Year > 2000) {
						<br/>
						<b>@member.MembershipEnd?.ToString("yyyy-MM-dd")</b>
					}
					else if (member.MembershipStart?.Year > 2000) {
						<br/>
						<b style="color: green">active</b>
					}
					else {
						<b style="color: red">unknown</b>
					} *@
					<b>
						@if(
							member.Memberships.LastOrDefault()?.End == null ||
							member.Memberships.LastOrDefault()?.End > DateTime.Now
						) {
							<b style="color: green">
								Active
								@if(member.Memberships.LastOrDefault()?.End != null) {
									<span>until @member.Memberships.LastOrDefault()?.End?.ToString("yyyy-MM-dd")</span>
								}
							</b>
						} else {
							<b>Inactive, ended @member.Memberships.LastOrDefault()?.End?.ToString("yyyy-MM-dd")</b>
						}
					</b>
					<ul>
						@foreach(var membership in member.Memberships) {
							<li data-member-id="@membership.MembershipId">
								@membership.Start?.ToString("yyyy-MM-dd")
								@if(@membership.End != null) {
									<span>- @membership.End?.ToString("yyyy-MM-dd")</span>
								} else {
									<span> and active</span>
								}
								[@(membership.MonthlyFeeCents / 100)€]
								<a class="btn btn-sm btn-secondary" href="/EditMembership/@membership.MembershipId">Edit</a>
							</li>
						}
					</ul>
					<a class="btn btn-sm btn-secondary" href="/AddMembership/@member.MemberId">+</a>
				</td>
				<td>
					
				</td>
				<td>
					@member.Notes?.Delimit(20, "...")
				</td>
				<td>
					<div class="btn-group" role="group">
						<a class="btn btn-sm btn-secondary" href="/GenMail/@member.MemberId">Generate mail</a>
						<a class="btn btn-sm btn-primary" href="/EditMember/@member.MemberId">Edit</a>
					</div>
				</td>
			</tr>
		}
		</tbody>
	</table>
	@{
		var activeMembers = db.Members.Where(p => p.MembershipStart.HasValue && p.MembershipStart.Value.Year > 2000 && (!p.MembershipEnd.HasValue || p.MembershipEnd.Value.Year < 2000));
		var votingMembers = activeMembers.Where(p => !p.NonVoting.HasValue || !p.NonVoting.Value);
		var nonVotingMembers = activeMembers.Where(p => p.NonVoting.HasValue && p.NonVoting.Value);
	}
	The AfRA currently has <b>@activeMembers.Count()</b> active members.
	Of these, <b>@votingMembers.Count()</b> are voting members.
	<br/>
	Non-voting members are: @string.Join(", ", nonVotingMembers.Select(p => string.IsNullOrWhiteSpace(p.Nick) ? p.Nick : $"{p.FirstName} {p.LastName}"))
</div>
