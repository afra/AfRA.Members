@page "{membershipId}"
@using AFRA.Members.Backend.database
@model AFRA.Members.Pages.EditMembership
@{
	ViewData["Title"] = "Add Membership";
	var membership = new Database.DbConn().Memberships.First(p => p.MembershipId == int.Parse(RouteData.Values["membershipId"]!.ToString()!));
	var member = new Database.DbConn().Members.First(p => p.MemberId == membership.MemberId);
}

<div class="text-center">
	<h1 class="display-5">
		Edit Membership [@membership.MembershipId] for @member.Nick
	</h1>
</div>

<form method="POST">
    using AFRA.Members.Backend.database.Tables;
	<h3>Memberhship</h3>
	<div class="mb-3">
		<label for="membership_start" class="form-label">Membership Start (required)</label>
		<input type="date" class="form-control" id="membership_start" name="membership_start" value="@membership.Start?.ToString("yyyy-MM-dd")" required="">
	</div>
	<div class="mb-3">
		<label for="membership_end" class="form-label">Membership End</label>
		<input type="date" class="form-control" id="membership_end" name="membership_end" value="@membership.End?.ToString("yyyy-MM-dd")">
	</div>

	<h3>Accounting</h3>
	<div class="mb-3">
		<label for="fee" class="form-label">Monthly fee (cents) (required)</label>
		<input type="number" min="100" class="form-control" id="fee" name="fee" value="@membership.MonthlyFeeCents">
	</div>

	<h3>Other</h3>
	<div class="mb-3">
		<label for="notes" class="form-label">Notes</label>
		<textarea maxlength="500" class="form-control" id="notes" name="notes">@membership.Notes</textarea>
	</div>
	<button type="submit" class="btn btn-primary">Save</button>
</form>
